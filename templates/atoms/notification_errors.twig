{% if active %}
  {% if list %}
    {% set reasons %}
      <ul class="reasons" id="error_list">
        {% for item in list %}
          {% if reason_txt[item] %}
            <li>{{ reason_txt[item] }}</li>
          {% else %}
            <li>{{ item }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endset %}
  {% endif %}
  {% include 'atoms/notification.twig' with {'type': 'danger', 'content': content, 'content_sub': reasons} %}
{% endif %}
